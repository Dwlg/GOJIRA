{
   "name": "soares289/gojira",
   "description": "Framework baseado no padrão MVC para simples e rapido desenvolvimento de aplicações WEB",
   "homepage": "https://github.com/soares289/GOJIRA",
   "license": "OSL-3.0",
   "keywords": ["GOJIRA", "MVC", "Framework","PHP","MySQL"],
   "minimum-stability": "stable",
   "prefer-stable": true,
   "authors": [
      {
         "name": "Carlsom Albert Soares",
         "email": "carlsom@micromacro.com.br"
      }
   ],
   "config": {
      "vendor-dir": "system/vendor",
      "platform": {
         "php": "8.0.2"
      }
   },
   "require": {
      "php": ">=8.0.0",
      "phpmailer/phpmailer": "^6.9",
      "smarty/smarty": "^5.8.4"
   },
   "scripts": {
      "post-install-cmd": "@remove-oauth-sample",
      "post-update-cmd": "@remove-oauth-sample",
      "remove-oauth-sample": "@php -r \"@unlink('system/vendor/phpmailer/phpmailer/get_oauth_token.php');\""
   }
}
