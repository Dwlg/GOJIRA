# Copie para .env e preencha. Onde colocar, em ordem de preferência: o caminho de
# GOJIRA_ENV_FILE (variável do servidor), a pasta pai do projeto se estiver fora
# do DOCUMENT_ROOT, ou a pasta do projeto (protegida pelo .htaccess).
# O .env fica fora do git e nunca pode ficar acessível pela web (docs/configuracao.md).
# Variáveis já definidas no ambiente do servidor têm precedência sobre este arquivo.

# Padrão 'PROD' (constants.php): credencial de exemplo ou BASE_URL derivado do
# Host sem TRUSTED_HOSTS recusam o boot, e display_errors fica desligado. Troque
# para DEV (credencial de exemplo só gera log) em desenvolvimento local.
# Com GOJIRA_STRICT_CONFIG=1 a recusa vale mesmo em DEV.
ENVIRONMENT=PROD
# GOJIRA_STRICT_CONFIG=1

# Banco de dados
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PWD=

# Envio de e-mail
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_NAME=

# URL base sem protocolo, terminada em "/" (ex.: www.exemplo.com.br/app/).
# Vazio: usa o app_configs.ini ou detecta por requisição, sem gravar.
GOJIRA_BASE_URL=

# Hosts aceitos, separados por vírgula (ex.: www.exemplo.com.br,.exemplo.com.br).
# Vazio: aceita qualquer Host. Preenchido: Host fora da lista recebe 400.
GOJIRA_TRUSTED_HOSTS=
