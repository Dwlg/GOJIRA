# Copie para project_demo/.env e preencha. O .env fica fora do git (.gitignore)
# e nunca pode ficar acessível pela web (ver docs/configuracao.md).
# Variáveis já definidas no ambiente do servidor têm precedência sobre este arquivo.

# DEV aceita credenciais de exemplo (com aviso no log); fora de DEV o boot falha.
ENVIRONMENT=DEV

# Banco de dados
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PWD=

# Envio de e-mail
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_NAME=

# URL base sem protocolo, terminada em "/" (ex.: www.exemplo.com.br/app/).
# Vazio: usa o app_configs.ini ou detecta por requisição, sem gravar.
GOJIRA_BASE_URL=

# Hosts aceitos, separados por vírgula (ex.: www.exemplo.com.br,.exemplo.com.br).
# Vazio: aceita qualquer Host. Preenchido: Host fora da lista recebe 400.
GOJIRA_TRUSTED_HOSTS=
