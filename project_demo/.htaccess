# Configuração local nunca é servida: .env (e qualquer arquivo iniciado por ponto)
# e .ini com cópias de backup (app_configs.ini, .ini.bak, .ini~).
# Vale com ou sem mod_rewrite e em qualquer subpasta.
<FilesMatch "(?i)(^\.|\.ini(\..*|~)?$)">
   <IfModule mod_authz_core.c>
      Require all denied
   </IfModule>
   <IfModule !mod_authz_core.c>
      Order allow,deny
      Deny from all
   </IfModule>
</FilesMatch>

# system/ e vendor/ nunca são servidos pela web a partir daqui, mesmo em uma
# instalação em que eles entram no docroot por symlink (hospedagem compartilhada
# com um único system/ para vários projetos). Vale com ou sem mod_rewrite e
# independe do .htaccess que o próprio system/ tenha.
<IfModule mod_authz_core.c>
   <If "%{REQUEST_URI} =~ m#^/?(?:[^/]+/)*?(system|vendor)(/|$)#i">
      Require all denied
   </If>
</IfModule>
<IfModule !mod_authz_core.c>
   <IfModule mod_rewrite.c>
      RewriteEngine On
      RewriteRule (^|/)(system|vendor)(/|$) - [F,L]
   </IfModule>
</IfModule>

RewriteEngine On

# Sem RewriteBase fixo: o mod_rewrite deriva a base do caminho físico do
# próprio .htaccess, então a regra funciona tanto na raiz do vhost quanto em
# qualquer subpasta (ex.: /project_demo/), sem editar este arquivo por ambiente.

RewriteRule ^webroot/(.*) webroot/$1 [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ configs.php?query=$1&%{QUERY_STRING} [L]
RewriteRule ^ configs.php?%{QUERY_STRING} [L]