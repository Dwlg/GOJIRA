# Configuração local nunca é servida: .env (e qualquer arquivo iniciado por ponto)
# e .ini (app_configs.ini). Vale com ou sem mod_rewrite e em qualquer subpasta.
<FilesMatch "(?i)(^\.|\.ini$)">
   <IfModule mod_authz_core.c>
      Require all denied
   </IfModule>
   <IfModule !mod_authz_core.c>
      Order allow,deny
      Deny from all
   </IfModule>
</FilesMatch>

RewriteEngine On

RewriteBase /project_demo/

RewriteRule ^system/(.*) system/$1 [L]
RewriteRule ^vendor/(.*) vendor/$1 [L]
RewriteRule ^webroot/(.*) webroot/$1 [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ configs.php?query=$1&%{QUERY_STRING} [L]
RewriteRule ^ configs.php?%{QUERY_STRING} [L]